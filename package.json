{
  "name": "hello_world",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc && npm run build:hub",
    "build:hub": "tsc --ignoreConfig --target ES2022 --module ES2022 --strict --skipLibCheck outreach-hub/components/menu-bar.ts && npm run build:styles",
    "build:styles": "sass outreach-hub/components/menu-bar.module.scss outreach-hub/components/menu-bar.module.css --no-source-map",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1135.0",
    "jest": "^30",
    "sass": "^1.107.1",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1120.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-sns": "^3.1120.0",
    "@aws-sdk/lib-dynamodb": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "aws-cdk-lib": "^2.263.0",
    "bootstrap": "^6.0.0-alpha.1",
    "constructs": "^10.5.0"
  }
}
